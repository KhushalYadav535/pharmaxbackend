// This is your Prisma schema file for the Pharmax FFMS platform
// Aligned with FFMS-Data-Fields.xlsx
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// â”€â”€â”€ Enums â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

enum UserRole {
  MR // Medical Representative
  TRADE_REP // Trade Representative / TSO
  DISTRIBUTOR_REP // Distributor Sales Representative
  ASM // Area Sales Manager
  RSM // Regional Sales Manager
  ZM // Zonal Manager
  NSM // National Sales Manager
  PRODUCT_MANAGER
  MARKETING
  SALES_ADMIN
  SUPER_ADMIN
}

enum VisitType {
  DOCTOR
  RETAILER
  DISTRIBUTOR
  HOSPITAL
  STOCKIST
}

enum VisitStatus {
  PLANNED
  CHECKED_IN
  COMPLETED
  MISSED
  CANCELLED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum OrderStatus {
  DRAFT
  SUBMITTED
  PROCESSING
  DISPATCHED
  DELIVERED
  CANCELLED
}

enum ExpenseType {
  TA // Travel Allowance
  DA // Daily Allowance
  ACCOMMODATION
  ENTERTAINMENT
  MISCELLANEOUS
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  ON_LEAVE
  HOLIDAY
}

enum ContentType {
  PDF
  VIDEO
  IMAGE
  PRESENTATION
  ANIMATION
}

enum DoctorClassification {
  A_PLUS
  A
  B
  C
  D
}

// â”€â”€â”€ FFMS New Enums â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum MaritalStatus {
  MARRIED
  UNMARRIED
  SEPARATED
  DIVORCED
  WIDOWED
}

enum TaskType {
  CALL
  EMAIL
  TODO
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum TaskStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum RetailerCategory {
  A
  B
  C
  NOT_APPLICABLE
}

enum FareType {
  BUS
  TRAIN
  AUTO
  OWN_VEHICLE
  TAXI
}

// â”€â”€â”€ Core Auth & User / Employee Models â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model User {
  id                  String         @id @default(uuid())
  email               String         @unique
  passwordHash        String
  prefix              String? // Salutation (FFMS Employee sheet)
  firstName           String
  middleName          String? // Middle Name (FFMS Employee sheet)
  lastName            String
  phone               String?
  role                UserRole
  employeeId          String?        @unique // Employee Code â€” autogenerated
  // â”€â”€ FFMS Employee Master fields â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
  qualification       String? // Qualification
  gender              Gender? // Gender
  bloodGroup          String? // Blood Group (FFMS Employee sheet)
  maritalStatus       MaritalStatus? // Marital Status
  address1            String? // Address 1
  address2            String? // Address 2
  city                String? // City
  district            String? // District
  state               String? // State
  pin                 String? // Pin Code
  whatsappNumber      String? // WhatsApp Number
  dateOfBirth         DateTime? // Date of Birth
  marriageAnniversary DateTime? // Marriage Anniversary
  facebook            String? // Facebook
  instagram           String? // Instagram
  twitter             String? // Twitter
  linkedin            String? // LinkedIn
  spouseName          String? // Spouse Name
  dependents          Int? // No of Dependents
  aadharNumber        String? // Aadhar Number
  panNumber           String? // PAN Number
  grade               String? // Grade
  // HQ assignment
  hqId                String? // Reference to Headquarter (Territory)
  hq                  Territory?     @relation("EmployeeHQ", fields: [hqId], references: [id])
  // â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
  designation         String?
  department          String? // Employee dept (from FFMS Employee sheet)
  dateOfJoining       DateTime? // DOJ (from FFMS Employee sheet)
  profilePhoto        String?
  isActive            Boolean        @default(true)
  lastLoginAt         DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  deletedAt           DateTime?

  // Relations
  territories   UserTerritory[]
  refreshTokens RefreshToken[]
  visits        Visit[]              @relation("VisitCreatedBy")
  managedVisits Visit[]              @relation("VisitApprovedBy")
  expenses      Expense[]
  attendances   Attendance[]
  leaves        Leave[]
  samples       SampleDistribution[]
  orders        Order[]
  tourPlans     TourPlan[]
  notifications Notification[]       @relation("NotificationTo")
  sentNotifs    Notification[]       @relation("NotificationFrom")
  auditLogs     AuditLog[]
  quizAttempts  QuizAttempt[]
  contentViews  ContentView[]
  retailAudits  RetailAudit[]
  manager       User?                @relation("ManagerReports", fields: [managerId], references: [id])
  managerId     String?
  reports       User[]               @relation("ManagerReports")
  tasks         Task[]               @relation("TaskAssignedTo")
  createdTasks  Task[]               @relation("TaskCreatedBy")
  dailyReports  DailyVisitReport[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  isRevoked Boolean  @default(false)

  @@map("refresh_tokens")
}

// â”€â”€â”€ Territory / Headquarter Models â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model Territory {
  id            String             @id @default(uuid())
  name          String // Headquarter Name
  code          String             @unique
  district      String? // District (from FFMS HQ sheet)
  state         String
  region        String?
  zone          String?
  pinCode       String? // Pin Code (from FFMS HQ sheet)
  parentId      String?
  parent        Territory?         @relation("TerritoryHierarchy", fields: [parentId], references: [id])
  children      Territory[]        @relation("TerritoryHierarchy")
  users         UserTerritory[]
  beats         Beat[]
  // Named relations to support both HQ and Territory FKs
  doctorsHQ     Doctor[]           @relation("DoctorHQ")
  doctorsTerr   Doctor[]           @relation("DoctorTerritory")
  hospitalsHQ   Hospital[]         @relation("HospitalHQ")
  hospitalsTerr Hospital[]         @relation("HospitalTerritory")
  retailersHQ   Retailer[]         @relation("RetailerHQ")
  retailersTerr Retailer[]         @relation("RetailerTerritory")
  distributors  Distributor[]
  stockists     Stockist[]
  locations     Location[]
  cfas          CFA[]
  targets       Target[]
  surveys       Survey[]
  areas         Area[]
  interiors     Interior[]
  tourPlans     TourPlan[]
  expenses      Expense[]
  dailyReports  DailyVisitReport[]
  employees     User[]             @relation("EmployeeHQ")
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@map("territories")
}

model UserTerritory {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  territoryId String
  territory   Territory @relation(fields: [territoryId], references: [id], onDelete: Cascade)
  isPrimary   Boolean   @default(true)
  assignedAt  DateTime  @default(now())

  @@unique([userId, territoryId])
  @@map("user_territories")
}

// â”€â”€â”€ FFMS: Location Master â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model Location {
  id           String     @id @default(uuid())
  locationCode String?    @unique // Auto-generated
  name         String // Location Name
  district     String?
  state        String?
  pinCode      String?
  hqId         String? // Reference to Headquarter/Territory
  hq           Territory? @relation(fields: [hqId], references: [id])
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  interiors    Interior[]
  areas        Area[]
  tourPlans    TourPlan[]
  expenses     Expense[]
  dailyReports DailyVisitReport[]

  @@map("locations")
}

// â”€â”€â”€ FFMS: Interior Master â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model Interior {
  id           String     @id @default(uuid())
  interiorCode String?    @unique
  name         String
  district     String?
  state        String?
  pinCode      String?
  locationId   String?
  location     Location?  @relation(fields: [locationId], references: [id])
  hqId         String?
  hq           Territory? @relation(fields: [hqId], references: [id])
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@map("interiors")
}

// â”€â”€â”€ FFMS: Area within City Master â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model Area {
  id         String     @id @default(uuid())
  areaCode   String?    @unique
  name       String
  district   String?
  state      String?
  pinCode    String?
  locationId String?
  location   Location?  @relation(fields: [locationId], references: [id])
  hqId       String?
  hq         Territory? @relation(fields: [hqId], references: [id])
  isActive   Boolean    @default(true)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  doctors      Doctor[]
  hospitals    Hospital[]
  retailers    Retailer[]
  stockists    Stockist[]
  cfas         CFA[]
  tourPlans    TourPlan[]
  expenses     Expense[]
  tourPlanDays TourPlanDay[]

  @@map("areas")
}

model Beat {
  id          String     @id @default(uuid())
  name        String
  code        String?
  territoryId String
  territory   Territory  @relation(fields: [territoryId], references: [id])
  tourPlans   TourPlan[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("beats")
}

// â”€â”€â”€ FFMS: CFA Master â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model CFA {
  id                  String         @id @default(uuid())
  cfaCode             String?        @unique // Auto-generated, non-editable
  name                String
  category            String? // A, B, C etc.
  gstinNumber         String?
  panNumber           String?
  contactFirstName    String?
  contactLastName     String?
  contactDesignation  String?
  contactDept         String?
  gender              Gender?
  maritalStatus       MaritalStatus?
  address1            String?
  address2            String?
  city                String?
  district            String?
  state               String?
  pin                 String?
  geoTag              String? // "lat,lng" string
  areaId              String?
  area                Area?          @relation(fields: [areaId], references: [id])
  hqId                String?
  hq                  Territory?     @relation(fields: [hqId], references: [id])
  mobileNumber        String?
  whatsappNumber      String?
  email               String?
  dateOfBirth         DateTime?
  marriageAnniversary DateTime?
  website             String?
  facebook            String?
  instagram           String?
  twitter             String?
  visitDays           String[] // MON, TUE, etc.
  isActive            Boolean        @default(true)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  deletedAt           DateTime?

  stockists        Stockist[]
  productsSelected CFAProduct[]
  hospitals        Hospital[]

  @@map("cfas")
}

// â”€â”€â”€ FFMS: Stockist Master â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model Stockist {
  id                  String            @id @default(uuid())
  stockistCode        String?           @unique // Auto-generated, non-editable
  name                String
  gstinNumber         String?
  panNumber           String?
  contactFirstName    String?
  contactLastName     String?
  contactDesignation  String?
  contactDept         String?
  gender              Gender?
  maritalStatus       MaritalStatus?
  category            RetailerCategory?
  address1            String?
  address2            String?
  city                String?
  district            String?
  state               String?
  pin                 String?
  geoTag              String? // "lat,lng" string
  areaId              String?
  area                Area?             @relation(fields: [areaId], references: [id])
  hqId                String?
  hq                  Territory?        @relation(fields: [hqId], references: [id])
  mobileNumber        String?
  whatsappNumber      String?
  email               String?
  dateOfBirth         DateTime?
  marriageAnniversary DateTime?
  website             String?
  facebook            String?
  instagram           String?
  twitter             String?
  visitDays           String[] // MON, TUE, WED etc.
  cfaId               String?
  cfa                 CFA?              @relation(fields: [cfaId], references: [id])
  approvalStatus      ApprovalStatus    @default(PENDING)
  isActive            Boolean           @default(true)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  deletedAt           DateTime?

  retailers        Retailer[]
  visits           Visit[]
  stockReports     StockReport[]
  dailyReports     DailyVisitReport[]
  productsSelected StockistProduct[]

  @@map("stockists")
}

// â”€â”€â”€ Doctor CRM â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model Doctor {
  id                    String               @id @default(uuid())
  doctorCode            String?              @unique // Auto-generated, non-editable
  salutation            String?
  firstName             String
  middleName            String? // FFMS: Middle Name
  lastName              String
  specialty             String
  subSpecialty          String?
  qualification         String?
  experienceYears       Int?
  classification        DoctorClassification @default(B)
  category              String? // FFMS: Category (Specialist/General etc.)
  prescriber            Boolean              @default(true) // FFMS: Prescriber flag
  prescriptionPotential Int                  @default(0)
  // FFMS Fields
  gender                Gender?
  maritalStatus         MaritalStatus?
  phone                 String?
  whatsappNumber        String?
  email                 String?
  dateOfBirth           DateTime?
  marriageAnniversary   DateTime?
  address1              String?
  address2              String?
  city                  String?
  district              String?
  state                 String?
  pincode               String?
  geoTag                String? // "lat,lng" string (replaces geoTagLat/geoTagLng)
  geoTagLat             Float? // legacy kept for backward compat
  geoTagLng             Float? // legacy
  areaId                String?
  area                  Area?                @relation(fields: [areaId], references: [id])
  hqId                  String? // FFMS: HQ
  hq                    Territory?           @relation("DoctorHQ", fields: [hqId], references: [id])
  retailerId            String? // FFMS: Retailer FK
  retailer              Retailer?            @relation(fields: [retailerId], references: [id])
  website               String?
  facebook              String?
  instagram             String?
  twitter               String?
  visitDays             String[] // MON, TUE, etc.
  // Legacy fields
  address               String?
  territoryId           String?
  territory             Territory?           @relation("DoctorTerritory", fields: [territoryId], references: [id])
  hospitalId            String?
  hospital              Hospital?            @relation(fields: [hospitalId], references: [id])
  isKol                 Boolean              @default(false)
  kolCategory           String?
  visitFrequency        Int                  @default(1)
  lastVisitDate         DateTime?
  nextFollowUpDate      DateTime?
  notes                 String?
  approvalStatus        ApprovalStatus       @default(PENDING)
  isActive              Boolean              @default(true)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  deletedAt             DateTime?

  visits              Visit[]
  sampleDistributions SampleDistribution[]
  tags                DoctorTag[]
  dailyReports        DailyVisitReport[]
  productsSelected    DoctorProduct[]

  @@map("doctors")
}

model DoctorTag {
  id       String @id @default(uuid())
  doctorId String
  doctor   Doctor @relation(fields: [doctorId], references: [id])
  tag      String

  @@unique([doctorId, tag])
  @@map("doctor_tags")
}

// Doctor â†” Product many-to-many
model DoctorProduct {
  id        String  @id @default(uuid())
  doctorId  String
  doctor    Doctor  @relation(fields: [doctorId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])

  @@unique([doctorId, productId])
  @@map("doctor_products")
}

// â”€â”€â”€ Hospital CRM â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model Hospital {
  id                  String         @id @default(uuid())
  hospitalCode        String?        @unique // Auto-generated
  name                String
  type                String? // govt, private, corporate
  category            String? // FFMS: Category
  beds                Int?
  departments         String[]
  gstinNumber         String? // FFMS: GSTIN
  panNumber           String? // FFMS: PAN
  contactFirstName    String?
  contactLastName     String?
  contactDesignation  String?
  contactDept         String?
  gender              Gender?
  maritalStatus       MaritalStatus?
  address1            String?
  address2            String?
  address             String?
  city                String?
  district            String?
  state               String?
  pincode             String?
  areaId              String?
  area                Area?          @relation(fields: [areaId], references: [id])
  hqId                String? // FFMS: Headquarter
  hq                  Territory?     @relation("HospitalHQ", fields: [hqId], references: [id])
  cfaId               String? // FFMS: CFA
  cfa                 CFA?           @relation(fields: [cfaId], references: [id])
  geoTag              String? // "lat,lng" string
  geoTagLat           Float? // legacy
  geoTagLng           Float? // legacy
  phone               String?
  whatsappNumber      String?
  email               String?
  dateOfBirth         DateTime?
  marriageAnniversary DateTime?
  website             String?
  facebook            String?
  instagram           String?
  twitter             String?
  visitDays           String[]
  territoryId         String?
  territory           Territory?     @relation("HospitalTerritory", fields: [territoryId], references: [id])
  approvalStatus      ApprovalStatus @default(PENDING)
  isActive            Boolean        @default(true)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  deletedAt           DateTime?

  doctors          Doctor[]
  visits           Visit[]
  dailyReports     DailyVisitReport[]
  productsSelected HospitalProduct[]

  @@map("hospitals")
}

// Hospital â†” Product many-to-many
model HospitalProduct {
  id         String   @id @default(uuid())
  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id])
  productId  String
  product    Product  @relation(fields: [productId], references: [id])

  @@unique([hospitalId, productId])
  @@map("hospital_products")
}

// CFA â†” Product many-to-many
model CFAProduct {
  id        String  @id @default(uuid())
  cfaId     String
  cfa       CFA     @relation(fields: [cfaId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])

  @@unique([cfaId, productId])
  @@map("cfa_products")
}

// Stockist â†” Product many-to-many
model StockistProduct {
  id         String   @id @default(uuid())
  stockistId String
  stockist   Stockist @relation(fields: [stockistId], references: [id])
  productId  String
  product    Product  @relation(fields: [productId], references: [id])

  @@unique([stockistId, productId])
  @@map("stockist_products")
}

// â”€â”€â”€ Retailer/Pharmacy CRM â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model Retailer {
  id                  String            @id @default(uuid())
  retailerCode        String?           @unique // Auto-generated, non-editable
  name                String
  gstinNumber         String?
  panNumber           String?
  contactFirstName    String?
  contactLastName     String?
  contactDesignation  String?
  contactDept         String?
  gender              Gender?
  maritalStatus       MaritalStatus?
  category            RetailerCategory?
  address1            String?
  address2            String?
  city                String?
  district            String?
  state               String?
  pin                 String?
  geoTag              String? // "lat,lng" string
  geoTagLat           Float? // legacy
  geoTagLng           Float? // legacy
  areaId              String?
  area                Area?             @relation(fields: [areaId], references: [id])
  hqId                String? // FFMS: Headquarter
  hq                  Territory?        @relation("RetailerHQ", fields: [hqId], references: [id])
  mobileNumber        String?
  whatsappNumber      String?
  email               String?
  dateOfBirth         DateTime?
  marriageAnniversary DateTime?
  website             String?
  facebook            String?
  instagram           String?
  twitter             String?
  visitDays           String[]
  // Legacy fields kept for backward compat
  ownerName           String?
  pharmacistName      String?
  phone               String?
  address             String?
  pincode             String?
  gstNumber           String?
  drugLicenseNumber   String?
  drugLicenseExpiry   DateTime?
  potentialScore      Int               @default(0)
  visitFrequency      Int               @default(2)
  lastVisitDate       DateTime?
  // Relations
  stockistId          String?
  stockist            Stockist?         @relation(fields: [stockistId], references: [id])
  distributorId       String?
  distributor         Distributor?      @relation(fields: [distributorId], references: [id])
  territoryId         String?
  territory           Territory?        @relation("RetailerTerritory", fields: [territoryId], references: [id])
  approvalStatus      ApprovalStatus    @default(PENDING)
  isActive            Boolean           @default(true)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  deletedAt           DateTime?

  visits           Visit[]
  orders           Order[]
  retailAudits     RetailAudit[]
  stockReports     StockReport[]
  dailyReports     DailyVisitReport[]
  productsSelected RetailerProduct[]
  doctors          Doctor[]

  @@map("retailers")
}

// Retailer â†” Product many-to-many
model RetailerProduct {
  id         String   @id @default(uuid())
  retailerId String
  retailer   Retailer @relation(fields: [retailerId], references: [id])
  productId  String
  product    Product  @relation(fields: [productId], references: [id])

  @@unique([retailerId, productId])
  @@map("retailer_products")
}

// â”€â”€â”€ Distributor CRM (kept, Stockist is separate per FFMS) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model Distributor {
  id                String         @id @default(uuid())
  name              String
  ownerName         String?
  phone             String?
  email             String?
  address           String?
  city              String?
  state             String?
  pincode           String?
  gstNumber         String?
  drugLicenseNumber String?
  warehouseAddress  String?
  creditLimit       Float          @default(0)
  creditDays        Int            @default(30)
  outstandingAmount Float          @default(0)
  territoryId       String?
  territory         Territory?     @relation(fields: [territoryId], references: [id])
  approvalStatus    ApprovalStatus @default(PENDING)
  isActive          Boolean        @default(true)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  deletedAt         DateTime?

  retailers Retailer[]
  visits    Visit[]
  orders    Order[]

  @@map("distributors")
}

// â”€â”€â”€ Product Master â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model Product {
  id             String    @id @default(uuid())
  productCode    String?   @unique // Product ID â€” auto-generated, non-editable
  name           String
  composition    String? // Composition
  scientificName String? // Scientific Name
  speciality     String? // General, Gyne, Pediatric etc.
  category       String? // Pills, Syrup, Sachet etc.
  unitsInPackage Float? // No of Units in Package
  storageTemp    Float? // Storage Temperature
  productDetails String? // Product Details
  productImage   String? // Product Image URL
  description    String? // kept for compat
  mrp            Float // Maximum Retail Price
  ptr            Float // Price to Retailer
  pts            Float // Price to Stockist
  unit           String    @default("Strip")
  applicableFrom DateTime? // Applicable From
  applicableTo   DateTime? // Applicable To
  code           String?   @unique // legacy code field
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  orderItems        OrderItem[]
  doctorsSelected   DoctorProduct[]
  hospitalsSelected HospitalProduct[]
  retailersSelected RetailerProduct[]
  stockReports      StockReport[]
  surveys           Survey[]
  cfaproducts       CFAProduct[]
  stockistProducts  StockistProduct[]

  @@map("products")
}

// â”€â”€â”€ FFMS: Daily Visit Report (Standalone â€” Doctor/Hospital/Retailer/Stockist) â”€

model DailyVisitReport {
  id String @id @default(uuid())

  // Who & Where
  employeeId String
  employee   User       @relation(fields: [employeeId], references: [id])
  hqId       String? // Headquarter ID â€” FK to Territory
  hq         Territory? @relation(fields: [hqId], references: [id])

  // Visit target (one of the below)
  visitType  VisitType
  doctorId   String?
  doctor     Doctor?   @relation(fields: [doctorId], references: [id])
  hospitalId String?
  hospital   Hospital? @relation(fields: [hospitalId], references: [id])
  retailerId String?
  retailer   Retailer? @relation(fields: [retailerId], references: [id])
  stockistId String?
  stockist   Stockist? @relation(fields: [stockistId], references: [id])

  // FFMS Fields
  visitDate        DateTime
  visitPurpose     String?
  visitFeedback    String?
  nextVisit        DateTime?
  remarks          String?
  jointVisit       Boolean   @default(false)
  jointVisitWith   String? // Manager name / ASM etc.
  productsPromoted String[] // FK reference to Product Master

  // Location (auto-captured)
  locationId      String?
  location        Location? @relation(fields: [locationId], references: [id])
  locationLat     Float?
  locationLng     Float?
  locationAddress String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("daily_visit_reports")
}

// Keep Territory relation for DailyVisitReport
// (Adding here because Territory doesn't have it yet)

// â”€â”€â”€ Visit Reporting (Check-in/Check-out) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model Visit {
  id        String      @id @default(uuid())
  visitType VisitType
  status    VisitStatus @default(PLANNED)

  // Who & When
  userId          String
  user            User      @relation("VisitCreatedBy", fields: [userId], references: [id])
  plannedDate     DateTime
  checkInTime     DateTime?
  checkOutTime    DateTime?
  durationMinutes Int?

  // GPS
  checkInLat     Float?
  checkInLng     Float?
  checkInAddress String?
  checkOutLat    Float?
  checkOutLng    Float?

  // Target entity (polymorphic)
  doctorId      String?
  doctor        Doctor?      @relation(fields: [doctorId], references: [id])
  hospitalId    String?
  hospital      Hospital?    @relation(fields: [hospitalId], references: [id])
  retailerId    String?
  retailer      Retailer?    @relation(fields: [retailerId], references: [id])
  distributorId String?
  distributor   Distributor? @relation(fields: [distributorId], references: [id])
  stockistId    String?
  stockist      Stockist?    @relation(fields: [stockistId], references: [id])

  // FFMS Visit Report Fields
  visitPurpose     String? // Visit Purpose
  visitFeedback    String? // Visit Feedback
  nextVisit        DateTime? // Next Visit date
  remarks          String? // Remarks
  jointVisit       Boolean   @default(false) // Joint Visit (Yes/No radio)
  jointVisitWith   String? // Joint Visit with whom (ASM, Management)
  productsPromoted String[] // Products Promoted (FK Product Master)

  // Legacy content fields (kept for backward compat)
  productsDiscussed  String[]
  objectionsRaised   String?
  competitorActivity String?
  doctorFeedback     String?
  nextFollowUpDate   DateTime?
  notes              String?

  // CRM Report Fields
  visitObjective String[]
  engagement     String?
  businessSignal String[]
  followUpAction String?

  // AI-generated
  aiSummary     String?
  aiNextActions String?

  // Approval
  approvalStatus  ApprovalStatus @default(PENDING)
  approvedById    String?
  approvedBy      User?          @relation("VisitApprovedBy", fields: [approvedById], references: [id])
  approvedAt      DateTime?
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tourPlanDayId String?
  tourPlanDay   TourPlanDay? @relation(fields: [tourPlanDayId], references: [id], onDelete: Cascade)

  attachments         VisitAttachment[]
  sampleDistributions SampleDistribution[]
  orders              Order[]

  @@map("visits")
}

model VisitAttachment {
  id              String   @id @default(uuid())
  visitId         String
  visit           Visit    @relation(fields: [visitId], references: [id])
  fileUrl         String
  fileType        String
  fileName        String
  aiTranscription String?
  createdAt       DateTime @default(now())

  @@map("visit_attachments")
}

// â”€â”€â”€ Tour Planning â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model TourPlan {
  id         String     @id @default(uuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id])
  hqId       String? // Headquarter ID — FK to Territory
  hq         Territory? @relation(fields: [hqId], references: [id])
  locationId String? // Location ID — FK to Location
  location   Location?  @relation(fields: [locationId], references: [id])
  areaId     String? // Area ID — FK to Area
  area       Area?      @relation(fields: [areaId], references: [id])
  beatId     String?
  beat       Beat?      @relation(fields: [beatId], references: [id])

  // New Monthly TP Fields
  planMonth   String? // e.g. "2026-09"
  workingDays Int           @default(0)
  days        TourPlanDay[]

  // Legacy FFMS Tour Planning Fields
  tourFromDate   DateTime? // Optional now
  tourToDate     DateTime? // Tour To Date
  tourPurpose    String? // Optional now
  jointVisit     Boolean   @default(false)
  jointVisitWith String?

  planDate       DateTime?
  approvalStatus ApprovalStatus @default(PENDING)
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@map("tour_plans")
}

model TourPlanDay {
  id         String   @id @default(uuid())
  tourPlanId String
  tourPlan   TourPlan @relation(fields: [tourPlanId], references: [id], onDelete: Cascade)
  date       DateTime
  areaId     String?
  area       Area?    @relation(fields: [areaId], references: [id])
  purpose    String?

  plannedVisits Visit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tour_plan_days")
}

// â”€â”€â”€ Sample Management â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model SampleProduct {
  id             String    @id @default(uuid())
  name           String
  code           String    @unique
  batchNumber    String?
  expiryDate     DateTime?
  openingBalance Int       @default(0)
  currentBalance Int       @default(0)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  distributions SampleDistribution[]

  @@map("sample_products")
}

model SampleDistribution {
  id              String        @id @default(uuid())
  sampleProductId String
  sampleProduct   SampleProduct @relation(fields: [sampleProductId], references: [id])
  userId          String
  user            User          @relation(fields: [userId], references: [id])
  doctorId        String?
  doctor          Doctor?       @relation(fields: [doctorId], references: [id])
  visitId         String?
  visit           Visit?        @relation(fields: [visitId], references: [id])
  quantity        Int
  batchNumber     String?
  distributedAt   DateTime      @default(now())
  notes           String?

  @@map("sample_distributions")
}

// â”€â”€â”€ Order Management â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model Order {
  id                   String       @id @default(uuid())
  orderNumber          String       @unique @default(cuid())
  status               OrderStatus  @default(DRAFT)
  userId               String
  user                 User         @relation(fields: [userId], references: [id])
  hqId                 String? // Headquarter ID (from FFMS Order sheet)
  retailerId           String?
  retailer             Retailer?    @relation(fields: [retailerId], references: [id])
  distributorId        String?
  distributor          Distributor? @relation(fields: [distributorId], references: [id])
  visitId              String?
  visit                Visit?       @relation(fields: [visitId], references: [id])
  orderDate            DateTime     @default(now()) // Order Date
  totalAmount          Float        @default(0)
  discount             Float        @default(0)
  notes                String?
  expectedDeliveryDate DateTime?
  deliveredAt          DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  items OrderItem[]

  @@map("orders")
}

model OrderItem {
  id            String  @id @default(uuid())
  orderId       String
  order         Order   @relation(fields: [orderId], references: [id])
  productId     String
  product       Product @relation(fields: [productId], references: [id])
  quantity      Int // Product Quantity
  productScheme String? // Product Scheme (from FFMS Order sheet)
  unitPrice     Float
  discount      Float   @default(0)
  totalPrice    Float

  @@map("order_items")
}

// â”€â”€â”€ FFMS: Stock Reporting â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model StockReport {
  id             String    @id @default(uuid())
  stockistId     String?
  stockist       Stockist? @relation(fields: [stockistId], references: [id])
  retailerId     String?
  retailer       Retailer? @relation(fields: [retailerId], references: [id])
  productId      String
  product        Product   @relation(fields: [productId], references: [id])
  reportFromDate DateTime
  reportToDate   DateTime
  // Opening
  openingQty     Float     @default(0)
  openingValue   Float     @default(0)
  // Receipt
  receiptQty     Float     @default(0)
  receiptValue   Float     @default(0)
  // Issue
  issueQty       Float     @default(0)
  issueValue     Float     @default(0)
  // Closing
  closingQty     Float     @default(0)
  closingValue   Float     @default(0)
  // Dump
  dumpQty        Float     @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("stock_reports")
}

// â”€â”€â”€ Trade Promotion / Schemes â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model Scheme {
  id          String   @id @default(uuid())
  name        String
  description String?
  type        String
  startDate   DateTime
  endDate     DateTime
  targetRole  String?
  minPurchase Float?
  reward      String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("schemes")
}

// â”€â”€â”€ Expenses â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model Expense {
  id         String     @id @default(uuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id])
  hqId       String? // Headquarter ID
  hq         Territory? @relation(fields: [hqId], references: [id])
  locationId String? // Location ID
  location   Location?  @relation(fields: [locationId], references: [id])
  areaId     String? // Area ID
  area       Area?      @relation(fields: [areaId], references: [id])

  // FFMS Expense Report Fields
  tourFromDate   DateTime? // Tour From Date
  tourToDate     DateTime? // Tour To Date
  distance       Float? // Distance (km)
  fare           Float? // Fare amount
  fareType       FareType? // Bus, Train, Auto etc.
  dailyAllowance Float? // Daily Allowance
  miscExpenses   Float? // Misc Expenses

  // Legacy fields
  expenseType     ExpenseType?
  amount          Float          @default(0)
  description     String?
  expenseDate     DateTime?
  receiptUrl      String?
  approvalStatus  ApprovalStatus @default(PENDING)
  approvedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@map("expenses")
}

// â”€â”€â”€ FFMS: Tasks â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model Task {
  id                String       @id @default(uuid())
  title             String // Task name (include 'call'/'email' for auto type)
  type              TaskType     @default(TODO) // Call, Email, Todo
  priority          TaskPriority @default(MEDIUM) // Low, Medium, High
  assignedToId      String?
  assignedTo        User?        @relation("TaskAssignedTo", fields: [assignedToId], references: [id])
  createdById       String?
  createdBy         User?        @relation("TaskCreatedBy", fields: [createdById], references: [id])
  queue             String? // Task queue name
  dueDate           DateTime?
  reminder          String? // e.g. "1 day before", "1 hour before"
  notes             String?
  status            TaskStatus   @default(NOT_STARTED)
  completionDate    DateTime?
  ownerAssignedDate DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@map("tasks")
}

// â”€â”€â”€ FFMS: Competitor Survey â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model Survey {
  id                           String     @id @default(uuid())
  hqId                         String?
  hq                           Territory? @relation(fields: [hqId], references: [id])
  surveyDate                   DateTime   @default(now()) // Current date, past dates not allowed
  productId                    String? // Our product (FK to Product)
  product                      Product?   @relation(fields: [productId], references: [id])
  competitorCompanyName        String
  competitorProductName        String
  competitorProductComposition String?
  maximumRetailPrice           Float?
  priceToStockist              Float?
  priceToRetailer              Float?
  createdAt                    DateTime   @default(now())
  updatedAt                    DateTime   @updatedAt

  @@map("surveys")
}

// â”€â”€â”€ FFMS: Target â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model Target {
  id           String    @id @default(uuid())
  targetYear   Int // Year
  targetAmount Float // Target amount (Mandatory)
  hqId         String
  hq           Territory @relation(fields: [hqId], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("targets")
}

// â”€â”€â”€ Attendance & Leave â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model Attendance {
  id           String           @id @default(uuid())
  userId       String
  user         User             @relation(fields: [userId], references: [id])
  date         DateTime
  status       AttendanceStatus
  checkInTime  DateTime?
  checkOutTime DateTime?
  checkInLat   Float?
  checkInLng   Float?
  notes        String?
  createdAt    DateTime         @default(now())

  @@unique([userId, date])
  @@map("attendances")
}

model Leave {
  id             String         @id @default(uuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id])
  leaveType      String
  startDate      DateTime
  endDate        DateTime
  reason         String?
  approvalStatus ApprovalStatus @default(PENDING)
  approvedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@map("leaves")
}

// â”€â”€â”€ Training â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model TrainingModule {
  id          String      @id @default(uuid())
  title       String
  description String?
  contentUrl  String?
  contentType ContentType @default(PDF)
  duration    Int?
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  quizzes  Quiz[]
  attempts QuizAttempt[]

  @@map("training_modules")
}

model Quiz {
  id            String         @id @default(uuid())
  moduleId      String
  module        TrainingModule @relation(fields: [moduleId], references: [id])
  question      String
  options       String[]
  correctAnswer Int
  explanation   String?

  @@map("quizzes")
}

model QuizAttempt {
  id          String         @id @default(uuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id])
  moduleId    String
  module      TrainingModule @relation(fields: [moduleId], references: [id])
  score       Int
  totalScore  Int
  passed      Boolean
  completedAt DateTime       @default(now())

  @@map("quiz_attempts")
}

// â”€â”€â”€ Content / Digital Detailing â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model Content {
  id           String      @id @default(uuid())
  title        String
  description  String?
  contentType  ContentType
  fileUrl      String
  thumbnailUrl String?
  productName  String?
  campaignId   String?
  campaign     Campaign?   @relation(fields: [campaignId], references: [id])
  version      String      @default("1.0")
  isActive     Boolean     @default(true)
  isDisabled   Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  views ContentView[]

  @@map("contents")
}

model ContentView {
  id        String   @id @default(uuid())
  contentId String
  content   Content  @relation(fields: [contentId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  viewedAt  DateTime @default(now())
  duration  Int?

  @@map("content_views")
}

model Campaign {
  id          String    @id @default(uuid())
  name        String
  description String?
  startDate   DateTime?
  endDate     DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  contents Content[]

  @@map("campaigns")
}

// â”€â”€â”€ Notifications â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model Notification {
  id         String    @id @default(uuid())
  toUserId   String
  toUser     User      @relation("NotificationTo", fields: [toUserId], references: [id])
  fromUserId String?
  fromUser   User?     @relation("NotificationFrom", fields: [fromUserId], references: [id])
  title      String
  body       String
  type       String
  data       Json?
  isRead     Boolean   @default(false)
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  @@map("notifications")
}

// â”€â”€â”€ Retail Audit â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model RetailAudit {
  id                   String   @id @default(uuid())
  retailerId           String
  retailer             Retailer @relation(fields: [retailerId], references: [id])
  userId               String
  user                 User     @relation(fields: [userId], references: [id])
  auditDate            DateTime @default(now())
  shelfSharePercent    Float?
  productPlacement     Int?
  priceCompliance      Boolean  @default(false)
  competitorVisibility Boolean  @default(false)
  stockAvailability    String[]
  outOfStock           String[]
  displayCompliance    Boolean  @default(false)
  competitorSchemes    String?
  totalScore           Int      @default(0)
  notes                String?
  photoUrls            String[]
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@map("retail_audits")
}

// â”€â”€â”€ Audit Log â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  oldValues Json?
  newValues Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@map("audit_logs")
}
